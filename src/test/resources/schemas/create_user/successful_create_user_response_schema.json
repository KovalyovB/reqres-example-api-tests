{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Successful create user response",
  "type": "object",
  "required": [
    "id",
    "token"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "integer"
    },
    "token": {
      "type": "string",
      "minLength": 1
    },
    "support": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "text": {
          "type": "string"
        },
        "sponsored_by": {
          "type": "string"
        }
      }
    },
    "_meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "powered_by": {
          "type": "string"
        },
        "docs_url": {
          "type": "string",
          "format": "uri"
        },
        "upgrade_url": {
          "type": "string",
          "format": "uri"
        },
        "example_url": {
          "type": "string",
          "format": "uri"
        },
        "variant": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "persisted": {
          "type": "boolean"
        },
        "persistence": {
          "type": "string"
        },
        "cta": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "label": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    }
  }
}